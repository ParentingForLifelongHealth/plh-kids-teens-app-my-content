{
  "flow_type": "generator",
  "flow_name": "gen_stack_module_start_at_id",
  "status": "released",
  "parameter_list": {
    "input_data_list": "modules",
    "output_flow_name": "stack_module_{@gen.id}_start_at_id",
    "output_flow_type": "template",
    "output_flow_subtype": "generated"
  },
  "rows": [
    {
      "name": "not_comp_count",
      "value": 0
    },
    {
      "name": "module_id",
      "value": "@gen.id"
    },
    {
      "type": "data_items",
      "name": "count_modules",
      "value": "@data.module_tasks",
      "action_list": [
        {
          "trigger": "data_changed",
          "action_id": "set_local",
          "args": [
            "not_comp_count",
            "@items.length"
          ],
          "_raw": "data_changed | set_local: not_comp_count: @items.length"
        }
      ],
      "parameter_list": [
        "filter: (@item.id !== @local.module_id) && !@item.completed && (!@item.age_list || @item.age_list.includes(@fields.child_age)) && (!@item.child_gender_list || @item.child_gender_list.includes(@fields.child_gender)) && (!@item.caregiver_relationship_list || @item.caregiver_relationship_list.includes(@fields.user_relationship))"
      ],
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "not comp: @local.not_comp_count",
      "condition": false,
      "exclude_from_translation": true
    },
    {
      "type": "data_items",
      "name": "pick_random_locked_activity",
      "value": "@data.activity_tasks",
      "parameter_list": [
        "filter: @item.locked && (@fields.child_age === undefined || !@item.child_age_list || ([].concat(@item.child_age_list)).map(x => String(x)).includes(String(@fields.child_age)))",
        "shuffle",
        "limit: 1"
      ],
      "exclude_from_translation": true,
      "rows": [
        {
          "type": "template",
          "name": "module_start_at_id",
          "value": "module_start_at_id_get_unlock",
          "action_list": [
            {
              "trigger": "completed",
              "action_id": "set_data",
              "args": [],
              "_raw": "completed | set_data | _list_id: module_tasks, _id: @gen.id, unlocked_activity: TRUE",
              "params": {
                "_list_id": "module_tasks",
                "_id": "@gen.id",
                "unlocked_activity": true
              }
            },
            {
              "trigger": "completed",
              "action_id": "set_field",
              "args": [
                "latest_unlocked_activity",
                "@item.id"
              ],
              "_raw": "completed | set_field: latest_unlocked_activity: @item.id"
            },
            {
              "trigger": "completed",
              "action_id": "nav_stack",
              "args": [
                "close_top"
              ],
              "_raw": "completed | nav_stack: close_top"
            },
            {
              "trigger": "completed",
              "action_id": "pop_up",
              "args": [
                "unlock_play"
              ],
              "_raw": "completed | pop_up: unlock_play | variant: plh_completion",
              "params": {
                "variant": "plh_completion"
              }
            },
            {
              "trigger": "uncompleted",
              "action_id": "nav_stack",
              "args": [
                "close_top"
              ],
              "_raw": "uncompleted | nav_stack: close_top"
            }
          ],
          "rows": [
            {
              "name": "activity_id",
              "value": "@item.id"
            },
            {
              "name": "module_id",
              "value": "@gen.id"
            },
            {
              "name": "course_id",
              "value": "@gen.tag_course"
            },
            {
              "name": "unlock_all",
              "value": "@calc(@local.not_comp_count == 0)"
            }
          ]
        }
      ]
    }
  ],

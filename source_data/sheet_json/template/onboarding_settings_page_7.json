{
  "flow_type": "template",
  "flow_name": "onboarding_settings_page_7",
  "status": "released",
  "rows": [
    {
      "name": "facilitator_id",
      "value": "@fields.facilitator_id"
    },
    {
      "name": "facilitator_data",
      "value": "characters.@local.facilitator_id"
    },
    {
      "name": "facilitator_row",
      "value": "@data.@local.facilitator_data"
    },
    {
      "name": "speaker_name",
      "value": "@local.facilitator_row.name",
      "exclude_from_translation": true
    },
    {
      "name": "speaker_image_asset",
      "value": "@local.facilitator_row.image_asset",
      "exclude_from_translation": true
    },
    {
      "name": "speaker_position",
      "value": "left",
      "exclude_from_translation": true
    },
    {
      "name": "variant",
      "value": "gray",
      "exclude_from_translation": true
    },
    {
      "type": "text_bubble",
      "name": "text_bubble",
      "value": "@global.facilitator_message_faci_group_id",
      "parameter_list": "speaker_image_asset: @local.speaker_image_asset;\nspeaker_name: @local.speaker_name;\nspeaker_position: @local.speaker_position;\nvariant: @local.variant;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "name": "question_faci_group_id",
      "value": "@global.question_user_facilitator_group",
      "parameter_list": "style: emphasised;",
      "exclude_from_translation": true
    },
    {
      "type": "text_box",
      "name": "faci_group_id_input",
      "value": "@fields.faci_group_id",
      "parameter_list": "placeholder: @global.placeholder_user_facilitator_group;",
      "condition": "!!@fields.faci_group_id",
      "exclude_from_translation": true
    },
    {
      "type": "text_box",
      "name": "faci_group_id_input",
      "parameter_list": "placeholder: @global.placeholder_user_facilitator_group;",
      "condition": "!@fields.faci_group_id",
      "exclude_from_translation": true
    },
    {
      "name": "valid_faci_group_id_input",
      "value": "@calc((/^[a-zA-Z0-9]{4}$/.test(@local.faci_group_id_input)))",
      "exclude_from_translation": true
    },
    {
      "name": "valid_faci_group_id_input_or_null",
      "value": "@calc((/^[a-zA-Z0-9]{4}$/.test(@local.faci_group_id_input)) || @local.faci_group_id_input == '' || !@local.faci_group_id_input)",
      "exclude_from_translation": true
    },
    {
      "name": "result"
    },
    {
      "name": "show_loading",
      "value": false
    },
    {
      "type": "button",
      "value": "@global.join_group",
      "action_list": "click | set_local: show_loading: TRUE;\nclick | set_local: result: \"\"\"\";\nclick | plh_parent_group: join_remote |\naccess_code: @local.faci_group_id_input,\napp_user_id: @fields._app_user_id,\nauth_user_id: @fields._auth_user_id,\nresult_local_variable_name: result,\nname: @fields.user_name,\ngender: @fields.user_gender,\ntimestamp: @calc(now());\nclick | set_local: show_loading: FALSE;",
      "parameter_list": "disabled: !@local.valid_faci_group_id_input;"
    },
    {
      "type": "image",
      "name": "loading_image",
      "value": "images/icons/loading.gif",
      "style_list": "width: 48px;\nposition: fixed;\nleft: 50%;",
      "condition": "@local.show_loading",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@global.facilitator_input_restriction",
      "style_list": "color: #FF0000;\nfont-size: 14px",
      "condition": "@local.result?.error && !@local.valid_faci_group_id_input",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@global.error_invalid_group",
      "style_list": "color: #FF0000;\nfont-size: 14px",
      "condition": "@local.result?.error && @local.result?.message == \"User group not found\" && @local.valid_faci_group_id_input",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@global.error_unknown",
      "style_list": "color: #FF0000;\nfont-size: 14px",
      "condition": "@local.result?.error && @local.result?.message !== \"User group not found\"  && @local.valid_faci_group_id_input",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@global.success",
      "style_list": "color: green;\nfont-size: 14px",
      "condition": "@local.result?.success",
      "exclude_from_translation": true
    },
    {
      "name": "success",
      "value": "@local.result?.success",
      "exclude_from_translation": true
    },
    {
      "name": "completed_enabled",
      "value": "@local.success",
      "exclude_from_translation": true
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;",
      "exclude_from_translation": true
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;",
      "exclude_from_translation": true
    },
    {
      "type": "button",
      "name": "button_completed_2",
      "value": "@global.continue",
      "action_list": "click | set_field: faci_group_id: @local.faci_group_id_input;\nclick | emit: completed;",
      "parameter_list": "style: navigation;\ndisabled: !@local.completed_enabled",
      "style_list": "flex: 1",
      "exclude_from_translation": true
    },
    {
      "type": "button",
      "name": "button_skip",
      "value": "<u>@global.skip</u>",
      "action_list": "click | emit: completed;",
      "parameter_list": "variant: card;\nstyle: no-background;",
      "condition": "!@local.success",
      "exclude_from_translation": true
    },
    {
      "type": "end_display_group"
    }
  ]
}
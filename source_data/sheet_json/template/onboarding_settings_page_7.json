    },
    {
      "name": "speaker_image_asset",
      "value": "@local.facilitator_row.image_asset",
      "exclude_from_translation": true
    },
    {
      "name": "speaker_position",
      "value": "left",
      "exclude_from_translation": true
    },
    {
      "name": "variant",
      "value": "gray",
      "exclude_from_translation": true
    },
    {
      "type": "text_bubble",
      "name": "text_bubble",
      "value": "@global.facilitator_app_message",
      "parameter_list": "speaker_image_asset: @local.speaker_image_asset;\nspeaker_name: @local.speaker_name;\nspeaker_position: @local.speaker_position;\nvariant: @local.variant;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "name": "question_faci_group_id",
      "value": "@global.question_user_facilitator_group",
      "parameter_list": "style: emphasised;",
      "exclude_from_translation": true
    },
    {
      "type": "text_box",
      "name": "faci_group_id_input",
      "value": "@fields.faci_group_id",
      "parameter_list": "placeholder: @global.placeholder_faci_group_id",
      "condition": "!!@fields.faci_group_id",
      "exclude_from_translation": true
    },
    {
      "type": "text_box",
      "name": "faci_group_id_input",
      "parameter_list": "placeholder: @global.placeholder_faci_group_id",
      "condition": "!@fields.faci_group_id",
      "exclude_from_translation": true
    },
    {
      "name": "valid_faci_group_id_input",
      "value": "@calc((/^[a-zA-Z0-9]{4}$/.test(@local.faci_group_id_input)) || @local.faci_group_id_input == '' || !@local.faci_group_id_input)",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "name": "warning_faci_group_id_input",
      "value": "@global.facilitator_input_restriction",
      "style_list": "color: #FF0000;\nfont-size: 14px",
      "condition": "!@local.valid_faci_group_id_input",
      "exclude_from_translation": true
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_faci_group_id_input",
      "exclude_from_translation": true
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;",
      "exclude_from_translation": true
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;",
      "exclude_from_translation": true
    },
    {
      "type": "button",
      "name": "button_completed_2",
      "value": "@global.continue",
      "action_list": "click | set_field: faci_group_id: @local.faci_group_id;\nclick | emit: completed;",
      "parameter_list": "style: navigation;\ndisabled: !@local.completed_enabled",
      "style_list": "flex: 1",
      "exclude_from_translation": true
    },
    {
      "type": "end_display_group"
    }
  ]

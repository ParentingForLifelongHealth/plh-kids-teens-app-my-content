{
  "flow_type": "template",
  "flow_name": "certificate",
  "status": "released",
  "rows": [
    {
      "name": "n_reprints"
    },
    {
      "name": "certificate_to_print",
      "value": "test",
      "exclude_from_translation": true
    },
    {
      "name": "image_path",
      "value": " images/onboarding/loving_parent.svg"
    },
    {
      "type": "data_items",
      "name": "get_n_reprints",
      "value": "@data.certificate_user_data",
      "action_list": "data_changed | set_local : n_reprints: @items[0]?.n_reprints;",
      "parameter_list": "filter:  @item.id == @fields.cert_to_print;\nlimit: 1;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "Certificate with name @fields.certificate_name\nCertificate to print: @fields.cert_to_print\nn reprints: @local.n_reprints",
      "exclude_from_translation": true,
      "comments": "{\n\"name\", fields.certificate_name,\n\"template\", (lower(fields.deployment_prog_name) & \"_\" & fields.certificate_to_print &\"_\" & fields.content_group_id & \"_\" & contact.language )\n}"
    },
    {
      "type": "image",
      "value": "https://firebasestorage.googleapis.com/v0/b/idems-media-recorder.appspot.com/o/project%2FPLH%2Fsubproject%2FParentText_v2%2Fdeployment%2FMalaysia%2FresourceGroup%2Freward2%2Fbadge_learning.jpg?alt=media&token=653bcc73-d8ca-4de9-b012-f6a2c7d0b8a2"
    },
    {
      "type": "begin_display_group",
      "style_list": "justify-content: center;"
    },
    {
      "type": "button",
      "name": "download_button",
      "value": "@global.download",
      "action_list": "click | save_to_device: @local.image_path",
      "parameter_list": "icon: images/icons/download.svg;\nstyle: navigation;",
      "exclude_from_translation": true
    },
    {
      "type": "button",
      "name": "share_button",
      "value": "@global.share",
      "action_list": "click | share: file: @local.image_path",
      "parameter_list": "icon: images/icons/share.svg;\nstyle: navigation;",
      "exclude_from_translation": true
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "button",
      "name": "button_update_name",
      "value": "<u>@global.change_certificate_name</u>",
      "action_list": "click | pop_up: update_certificate_name;",
      "parameter_list": "variant: card;",
      "condition": "(@local.n_reprints <=2)",
      "exclude_from_translation": true
    },
    {
      "type": "button",
      "name": "button_update_name",
      "value": "<u>@global.change_certificate_name</u>",
      "action_list": "click | pop_up: no_more_reprints;",
      "parameter_list": "variant: card;",
      "condition": "(@local.n_reprints >2)",
      "exclude_from_translation": true
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "settings_faci_group_id",
  "status": "released",
  "rows": [
    {
      "name": "success",
      "value": "@local.result?.success",
      "exclude_from_translation": true
    },
    {
      "type": "begin_display_group",
      "name": "dg_row"
    },
    {
      "type": "round_button",
      "name": "back",
      "action_list": "click | emit: uncompleted",
      "condition": "!@local.success",
      "parameter_list": "icon_src: chevron-back;\nvariant: navigation"
    },
    {
      "type": "round_button",
      "name": "back",
      "action_list": "click | set_field: faci_group_id: @local.faci_group_id_input;\nclick | emit: completed;",
      "condition": "@local.success",
      "parameter_list": "icon_src: chevron-back;\nvariant: navigation"
    },
    {
      "type": "title",
      "name": "title",
      "value": "@global.faci_group_id_setting_title"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "name": "question_faci_group_id",
      "value": "@global.faci_group_id_setting",
      "exclude_from_translation": true
    },
    {
      "type": "text_box",
      "name": "faci_group_id_input",
      "value": "@fields.faci_group_id",
      "condition": "!!@fields.faci_group_id",
      "parameter_list": "placeholder: @global.placeholder_user_facilitator_group",
      "exclude_from_translation": true
    },
    {
      "type": "text_box",
      "name": "faci_group_id_input",
      "condition": "!@fields.faci_group_id",
      "parameter_list": "placeholder: @global.placeholder_user_facilitator_group",
      "exclude_from_translation": true
    },
    {
      "name": "valid_faci_group_id_input",
      "value": "@calc((/^[a-zA-Z0-9]{4}$/.test(@local.faci_group_id_input)))",
      "exclude_from_translation": true
    },
    {
      "name": "valid_faci_group_id_input_or_null",
      "value": "@calc((/^[a-zA-Z0-9]{4}$/.test(@local.faci_group_id_input)) || @local.faci_group_id_input == '' || !@local.faci_group_id_input)"
    },
    {
      "name": "result"
    },
    {
      "type": "button",
      "value": "@global.update_group",
      "action_list": "click | set_local: result: \"\"\"\";\nclick | plh_parent_group: join_remote |\naccess_code: @local.faci_group_id_input,\napp_user_id: @fields._app_user_id,\nauth_user_id: @fields._auth_user_id,\nresult_local_variable_name: result,\nname: @fields.user_name,\ngender: @fields.user_gender,\ntimestamp: @calc(now());;",
      "parameter_list": "disabled: !@local.valid_faci_group_id_input;"
    },
    {
      "type": "text",
      "value": "@global.facilitator_input_restriction",
      "style_list": "color: #FF0000;\nfont-size: 14px",
      "condition": "@local.result?.error && !@local.valid_faci_group_id_input",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@global.error_invalid_group",
      "style_list": "color: #FF0000;\nfont-size: 14px",
      "condition": "@local.result?.error && @local.result?.message == \"User group not found\" && @local.valid_faci_group_id_input",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@global.error_unknown",
      "style_list": "color: #FF0000;\nfont-size: 14px",
      "condition": "@local.result?.error && @local.result?.message !== \"User group not found\"  && @local.valid_faci_group_id_input",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@global.success",
      "style_list": "color: green;\nfont-size: 14px",
      "condition": "@local.result?.success",
      "exclude_from_translation": true
    }
  ]
}
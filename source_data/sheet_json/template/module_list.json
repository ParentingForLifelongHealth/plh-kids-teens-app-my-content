{
  "flow_type": "template",
  "flow_name": "module_list",
  "status": "released",
  "rows": [
    {
      "name": "background_list",
      "value": "var(--plh-module-list-item-background-1);\nvar(--plh-module-list-item-background-2);\nvar(--plh-module-list-item-background-3);"
    },
    {
      "name": "current_module_id"
    },
    {
      "name": "has_completed",
      "value": 0
    },
    {
      "name": "has_core_course",
      "value": 0
    },
    {
      "type": "data_items",
      "value": "@data.module_tasks",
      "action_list": "data_changed | set_local : current_module_id : @items[0]?.id",
      "parameter_list": "filter: @item.completed_ts && (!@item.tag_list || @item.tag_list.includes(@fields.child_age_tag));\nsort: number;\nlimit: 1;",
      "condition": false
    },
    {
      "type": "data_items",
      "value": "@data.courses",
      "action_list": "data_changed | set_local : has_core_course: @items.length;",
      "parameter_list": "filter: @item.core && !@item.completed;"
    },
    {
      "type": "data_items",
      "value": "@data.courses",
      "action_list": "data_changed | set_local : has_completed: @items.length;",
      "parameter_list": "filter: @item.completed;"
    },
    {
      "type": "begin_display_group",
      "name": "core_title",
      "condition": "@local.has_core_course > 0"
    },
    {
      "type": "title",
      "value": "Core Course"
    },
    {
      "type": "text",
      "value": "complete this course and unlock all your courses"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_data_items",
      "name": "core_courses",
      "value": "@data.courses",
      "parameter_list": "filter: @item.core && !@item.completed;",
      "exclude_from_translation": true
    },
    {
      "type": "begin_template",
      "value": "module_group",
      "exclude_from_translation": true
    },
    {
      "name": "course",
      "value": "@item.id",
      "exclude_from_translation": true
    },
    {
      "name": "course_title",
      "value": "@item.title"
    },
    {
      "name": "last_completed",
      "value": "@local.current_module_id"
    },
    {
      "type": "end_template",
      "exclude_from_translation": true
    },
    {
      "type": "end_data_items",
      "exclude_from_translation": true
    },
    {
      "type": "begin_display_group",
      "name": "upcoming_title",
      "condition": "@local.has_core_course > 0"
    },
    {
      "type": "title",
      "value": "Upcoming Courses"
    },
    {
      "type": "text",
      "value": "These courses will be available after the core courses are completed"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "unlocked_title",
      "condition": "@local.has_core_course == 0"
    },
    {
      "type": "title",
      "value": "Explore Courses"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "to complete"
    },
    {
      "type": "begin_data_items",
      "name": "other_courses",
      "value": "@data.courses",
      "parameter_list": "filter: !@item.core && !@item.completed;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@item.title",
      "condition": false
    },
    {
      "name": "testing",
      "value": "@item.id"
    },
    {
      "type": "begin_template",
      "value": "module_group",
      "exclude_from_translation": true
    },
    {
      "name": "course",
      "value": "@item.id",
      "exclude_from_translation": true
    },
    {
      "name": "course_title",
      "value": "@item.title"
    },
    {
      "name": "all_locked",
      "value": "(@local.has_core_course > 0)"
    },
    {
      "type": "end_template",
      "exclude_from_translation": true
    },
    {
      "type": "end_data_items",
      "exclude_from_translation": true
    },
    {
      "type": "begin_display_group",
      "name": "completed_title",
      "condition": "@local.has_completed > 0"
    },
    {
      "type": "title",
      "value": "Completed Courses"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_data_items",
      "name": "completed_courses",
      "value": "@data.courses",
      "parameter_list": "filter: @item.completed;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@item.title",
      "condition": false
    },
    {
      "name": "testing",
      "value": "@item.id"
    },
    {
      "type": "begin_template",
      "value": "module_group",
      "exclude_from_translation": true
    },
    {
      "name": "course",
      "value": "@item.id",
      "exclude_from_translation": true
    },
    {
      "name": "course_title",
      "value": "@item.title"
    },
    {
      "name": "last_completed",
      "value": "@local.current_module_id"
    },
    {
      "name": "show_completed",
      "value": true
    },
    {
      "type": "end_template",
      "exclude_from_translation": true
    },
    {
      "type": "end_data_items",
      "exclude_from_translation": true
    }
  ]
}
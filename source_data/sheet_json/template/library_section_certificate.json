{
  "flow_type": "template",
  "flow_name": "library_section_certificate",
  "status": "released",
  "rows": [
    {
      "name": "library_id",
      "value": "certificate",
      "condition": true
    },
    {
      "name": "library_id_concat",
      "value": "library_section.@local.library_id",
      "condition": true
    },
    {
      "name": "library_row",
      "value": "@data.@local.library_id_concat",
      "condition": true
    },
    {
      "name": "display_title",
      "value": "@local.library_row.title",
      "condition": true
    },
    {
      "type": "begin_data_items",
      "name": "core_courses",
      "value": "@data.courses",
      "exclude_from_translation": true,
      "comments": "filter: @item.core && !@item.completed;"
    },
    {
      "type": "begin_button",
      "value": "@item.title",
      "action_list": "click | set_field: cert_to_print: @item.id;\nclick | pop_up: certificate | fullscreen: true, showCloseButton: true;",
      "parameter_list": "variant: card-portrait;\nimage_asset: @item.image_asset;\ndisabled: !@item.completed;",
      "exclude_from_translation": true
    },
    {
      "type": "image",
      "value": "images/icons/locked.png",
      "condition": "!@item.completed;"
    },
    {
      "type": "end_button"
    },
    {
      "type": "end_data_items"
    }
  ]
}
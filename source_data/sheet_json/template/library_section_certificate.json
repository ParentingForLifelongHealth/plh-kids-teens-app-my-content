{
  "flow_type": "template",
  "flow_name": "library_section_certificate",
  "status": "released",
  "rows": [
    {
      "name": "library_id",
      "value": "certificate",
      "exclude_from_translation": true
    },
    {
      "name": "library_id_concat",
      "value": "library_section.@local.library_id",
      "exclude_from_translation": true
    },
    {
      "name": "library_row",
      "value": "@data.@local.library_id_concat",
      "exclude_from_translation": true
    },
    {
      "name": "display_title",
      "value": "@local.library_row.title",
      "exclude_from_translation": true
    },
    {
      "type": "begin_data_items",
      "name": "core_courses",
      "value": "@data.courses",
      "parameter_list": "filter:(!@item.age_list || @item.age_list.includes(@fields.child_age)) && (!@item.child_gender_list || @item.child_gender_list.includes(@fields.child_gender)) && (!@item.caregiver_relationship_list || @item.caregiver_relationship_list.includes(@fields.user_relationship));",
      "exclude_from_translation": true
    },
    {
      "name": "is_locked_@item.id"
    },
    {
      "type": "data_items",
      "value": "@data.hp_check_in",
      "action_list": "data_changed | set_local : is_locked_@item.id: @items[0]?.unlocked_activity;",
      "parameter_list": "filter:  @item.id == @fields.cert_to_print;\nlimit: 1;",
      "exclude_from_translation": true
    },
    {
      "type": "plh_module_list_item",
      "value": "@item.title",
      "action_list": "click | set_field: cert_to_print: @item.id;\nclick | pop_up: show_certificate | fullscreen: true, showCloseButton: true;",
      "parameter_list": "module_image_asset: @item.image_asset;\nis_locked: !@item.completed;\nlocked_image_asset: images/icons/locked.png;\n",
      "exclude_from_translation": true
    },
    {
      "type": "end_button"
    },
    {
      "type": "end_data_items"
    }
  ]
}